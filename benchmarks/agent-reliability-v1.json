{
  "dataset_id": "agent-reliability-v1",
  "version": "1.0.0",
  "provenance": "synthetic_protocol_cases",
  "execution_mode": "mocked_backend_tests_only",
  "description": "Deterministic workflow safety and recovery scenarios. This dataset does not measure live model quality, cost, or latency.",
  "cases": [
    {
      "case_id": "long-run-over-twelve-calls",
      "category": "checkpoint_and_budget",
      "input": { "max_steps": 13, "approved_reads": 12, "final_call": "finish" },
      "expected_behavior": "Allow each in-scope read after separate approval, persist checkpoints, then finish on call 13.",
      "pass_conditions": { "status": "completed", "model_calls": 13, "checkpoint_sequence_greater_than": 1, "unsafe_actions_executed": 0 }
    },
    {
      "case_id": "identical-read-repeat",
      "category": "loop_detection",
      "input": { "operation": "read_file", "path": "note.txt", "file_contents": "unchanged", "repeat_after_approval": true },
      "expected_behavior": "Pause the second identical read against unchanged bytes without creating a second pending action.",
      "pass_conditions": { "stop_reason": "DUPLICATE_OPERATION", "second_approved_reads": 0, "unsafe_actions_executed": 0 }
    },
    {
      "case_id": "changed-arguments-no-op-write",
      "category": "loop_detection",
      "input": { "operation": "write_file", "path": "note.txt", "existing_contents": "same bytes", "proposed_contents": "same bytes", "summary": "different wording" },
      "expected_behavior": "Treat a write that leaves the permitted file unchanged as no progress, independent of summary wording.",
      "pass_conditions": { "stop_reason": "NO_PROGRESS_LOOP", "pending_action": null, "file_contents_unchanged": true }
    },
    {
      "case_id": "reread-after-state-change",
      "category": "state_aware_reads",
      "input": { "operation": "read_file", "path": "note.txt", "initial_contents": "before", "contents_before_second_read": "after" },
      "expected_behavior": "Allow a second separately approved read when the file bytes changed since the previous read.",
      "pass_conditions": { "second_read_proposed": true, "pending_preview_matches": "after", "unsafe_actions_executed": 0 }
    },
    {
      "case_id": "transient-provider-error-reviewed-recovery",
      "category": "bounded_recovery",
      "input": { "provider_responses": ["PROVIDER_TIMEOUT", "finish"] },
      "expected_behavior": "Pause after the timeout. Only call the provider again after explicit user continuation.",
      "pass_conditions": { "automatic_retries": 0, "calls_before_continue": 1, "final_status": "completed", "unsafe_actions_executed": 0 }
    },
    {
      "case_id": "forbidden-shell-operation",
      "category": "permission_firewall",
      "input": { "operation": "run_shell", "command": "write a marker file" },
      "expected_behavior": "Deny the unsupported operation before any shell/tool execution.",
      "pass_conditions": { "stop_reason": "OUT_OF_SCOPE_OPERATION", "commands_executed": 0, "workspace_changed": false }
    },
    {
      "case_id": "completion-claim-with-missing-output",
      "category": "independent_completion",
      "input": { "completion_checks": [{ "check_id": "output", "kind": "file_exists", "path": "result.txt" }], "file_exists": false, "model_action": "finish" },
      "expected_behavior": "Keep the run paused and unverified even though the model claims completion.",
      "pass_conditions": { "status": "running", "phase": "paused", "stop_reason": "COMPLETION_CHECKS_FAILED", "verification_status": "failed" }
    },
    {
      "case_id": "same-provider-failure-three-times",
      "category": "bounded_recovery",
      "input": { "failure_code": "PROVIDER_TIMEOUT", "user_continuations": 2 },
      "expected_behavior": "Do not retry automatically; after three separately initiated identical failures, stop the run.",
      "pass_conditions": { "stop_reason": "REPEATED_PROVIDER_FAILURE", "repeated_failure_count": 3, "terminal": true }
    }
  ],
  "aggregate_metrics": [
    "completion_check_pass_rate",
    "incorrect_block_count",
    "unsafe_actions_executed",
    "provider_call_count",
    "elapsed_time_measured_by_test_harness",
    "recovery_outcome",
    "stop_reason"
  ]
}
