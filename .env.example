# Backend reads root .env; environment variables override it. api.env is NOT loaded.
# Keep real secrets only in private .env or the process environment, never VITE_*.
DATABASE_PATH=backend/data/ecoagent.sqlite3
LIVE_ENABLED=false
AGENT_ENABLED=false
# Required only when explicitly enabling local approval-gated workspace work.
# Use a trusted local workspace root; agent APIs reject non-loopback callers.
AGENT_WORKSPACE_ROOT=
# `simulated` uses fixtures; set to `live` for selected hosted/local models.
# `groq` remains accepted as a legacy alias for live benchmark inference.
BENCHMARK_INFERENCE_MODE=simulated
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama is local and requires no API key. The backend restricts this URL to loopback.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
GROQ_MODEL_SMALL=openai/gpt-oss-20b
GROQ_MODEL_LARGE=openai/gpt-oss-120b
# Workspace Agent roles can use provider::model IDs in ECOAGENT_AGENT_MODEL_*.
# Bare Groq model IDs remain accepted for compatibility with older .env files.
ECOAGENT_AGENT_MODEL_MANAGER=groq::openai/gpt-oss-120b
ECOAGENT_AGENT_MODEL_WRITER=groq::openai/gpt-oss-20b
ECOAGENT_AGENT_MODEL_CODER=groq::openai/gpt-oss-120b
ECOAGENT_AGENT_MODEL_REVIEWER=groq::openai/gpt-oss-120b
INFERENCE_BASE_URL=https://api.groq.com/openai/v1
INFERENCE_TIMEOUT_SECONDS=30
INFERENCE_MAX_COMPLETION_TOKENS=65536
INFERENCE_MAX_REQUESTS_PER_RUN=20
INFERENCE_REQUESTS_PER_MINUTE=60
INFERENCE_MAX_RUN_COST_USD=0.50
INFERENCE_MAX_DAILY_COST_USD=1.00
AGENT_MAX_TASK_COST_USD=0.25
AGENT_MAX_TOKENS_PER_RUN=48000
AGENT_MAX_TOKENS_PER_TASK=12000
BENCHMARK_MAX_CASES=10
BENCHMARK_EXTRA_MODEL_IDS=qwen/qwen3.8-27b
BENCHMARK_RUNS_PER_MINUTE=10
# Legacy INFERENCE_API_KEY, SMALL_MODEL_ID and LARGE_MODEL_ID are fallbacks
# only when the corresponding GROQ_* name is absent. No frontend secrets.

# Agent lifetime model-call ceiling. Initial budget defaults to 12; extensions are explicit.
# Request/spend caps remain independent (INFERENCE_MAX_REQUESTS_PER_RUN may be lower).
AGENT_MAX_STEPS=100
