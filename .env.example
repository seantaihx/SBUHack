# Backend reads root .env; environment variables override it. api.env is NOT loaded.
# Keep real secrets only in private .env or the process environment, never VITE_*.
DATABASE_PATH=backend/data/ecoagent.sqlite3
LIVE_ENABLED=false
AGENT_ENABLED=false
# Required only when explicitly enabling local approval-gated workspace work.
# Use a trusted local workspace root; agent APIs reject non-loopback callers.
AGENT_WORKSPACE_ROOT=
BENCHMARK_INFERENCE_MODE=simulated
GROQ_API_KEY=
GROQ_MODEL_SMALL=openai/gpt-oss-20b
GROQ_MODEL_LARGE=openai/gpt-oss-120b
INFERENCE_BASE_URL=https://api.groq.com/openai/v1
INFERENCE_TIMEOUT_SECONDS=30
INFERENCE_MAX_COMPLETION_TOKENS=65536
INFERENCE_MAX_REQUESTS_PER_RUN=20
INFERENCE_REQUESTS_PER_MINUTE=60
INFERENCE_MAX_RUN_COST_USD=0.50
INFERENCE_MAX_DAILY_COST_USD=1.00
BENCHMARK_MAX_CASES=10
BENCHMARK_EXTRA_MODEL_IDS=qwen/qwen3.8-27b
BENCHMARK_RUNS_PER_MINUTE=10
# Legacy INFERENCE_API_KEY, SMALL_MODEL_ID and LARGE_MODEL_ID are fallbacks
# only when the corresponding GROQ_* name is absent. No frontend secrets.
